# --- Client (inlined at BUILD time; rebuild after any change) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server (read at RUNTIME; never exposed to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# mock | hybrid | full
VITE_DATA_MODE=full

# Self-hosting only: build a plain Node server instead of a Cloudflare Worker
# NITRO_PRESET=node-server

# Port the Node server listens on (must match the CloudPanel "App Port")
PORT=3000
